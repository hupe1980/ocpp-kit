# Generated by packaging/homebrew/formula.sh for ocpp-kit @VERSION@; do not edit.
class OcppKit < Formula
  desc "OCPP 1.6J/2.0.1/2.1 tool: validate payloads, replay captures, mock a CSMS or station"
  homepage "https://hupe1980.github.io/ocpp-kit/docs/cli/"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    on_arm do
      url "https://github.com/hupe1980/ocpp-kit/releases/download/v@VERSION@/ocpp-darwin-aarch64.tar.gz"
      sha256 "@SHA256_ocpp-darwin-aarch64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/hupe1980/ocpp-kit/releases/download/v@VERSION@/ocpp-linux-aarch64.tar.gz"
      sha256 "@SHA256_ocpp-linux-aarch64@"
    end
    on_intel do
      url "https://github.com/hupe1980/ocpp-kit/releases/download/v@VERSION@/ocpp-linux-x86_64.tar.gz"
      sha256 "@SHA256_ocpp-linux-x86_64@"
    end
  end

  def install
    # Each archive holds one binary named after its platform.
    bin.install Dir["ocpp-*"].first => "ocpp"
  end

  test do
    assert_match "ocpp #{version}", shell_output("#{bin}/ocpp --version")
  end
end
